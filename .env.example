# Copy this file to .env and fill in only the credentials you actually
# have and are authorized to use. Never commit your real .env file.
# Any collector whose key is missing will simply skip that source and
# say so clearly in the report -- it will NOT fall back to scraping or
# any other workaround.

# Have I Been Pwned (or similar authorized breach-notification API)
HIBP_API_KEY=

# GitHub personal access token (optional - raises unauthenticated rate limits)
GITHUB_TOKEN=

# Example official social API credential (only used if you enable that
# collector). Never hardcode this anywhere else in the codebase.
TWITTER_BEARER_TOKEN=

# WHOIS/RDAP - most RDAP endpoints are public and need no key
RDAP_BASE_URL=https://rdap.org

# Networking / rate limiting
REQUEST_TIMEOUT_SECONDS=10
RATE_LIMIT_DELAY_SECONDS=1.0
